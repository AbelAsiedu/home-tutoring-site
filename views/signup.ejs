<%- include('partials/header') %>

<section class="page glass">
  <h1>Sign Up</h1>
  <% if (typeof error !== 'undefined') { %><div class="notice error"><%= error %></div><% } %>
  <form method="post" class="auth-form curved">
    <input name="name" placeholder="Full name" required>
    <input name="email" type="email" placeholder="Email" required>
    <input name="password" type="password" placeholder="Password" required>
    <label style="margin-top:12px">Account Type</label>
    <select name="role" required>
      <option value="user">Parent/Student</option>
      <option value="tutor">Tutor</option>
    </select>
    <button type="submit">Create Account</button>
  </form>
</section>

<%- include('partials/footer') %>
