<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Creator Dashboard - The Modern Pedagogues</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/darkmode.css">
</head>
<body>

<%
const contentList = typeof content !== 'undefined' ? content : [];
const draftCount = contentList.filter(c => c.status === 'draft').length;
const publishedCount = contentList.filter(c => c.status === 'published').length;
const totalDownloads = contentList.reduce((sum, c) => sum + (c.download_count || 0), 0);
%>

<%- include('../partials/header') %>

<main class="container">
  <section class="page glass">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
      <div>
        <h1 style="margin: 0 0 8px;">Creator Dashboard</h1>
        <p class="muted" style="margin: 0;">Manage your content, track earnings, and grow your audience.</p>
      </div>
      <a href="/marketplace/upload" class="btn">+ Upload New</a>
    </div>

    <!-- Stats Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px;">
      <div class="glass" style="padding: 16px; border-radius: 12px;">
        <div class="muted" style="font-size: 0.85rem; margin-bottom: 6px;">TOTAL CONTENT</div>
        <div style="font-size: 2rem; font-weight: 700; color: var(--accent-2);">
          <%= contentList.length %>
        </div>
      </div>

      <div class="glass" style="padding: 16px; border-radius: 12px;">
        <div class="muted" style="font-size: 0.85rem; margin-bottom: 6px;">PUBLISHED</div>
        <div style="font-size: 2rem; font-weight: 700; color: var(--accent);">
          <%= publishedCount %>
        </div>
      </div>

      <div class="glass" style="padding: 16px; border-radius: 12px;">
        <div class="muted" style="font-size: 0.85rem; margin-bottom: 6px;">TOTAL DOWNLOADS</div>
        <div style="font-size: 2rem; font-weight: 700; color: #10b981;">
          <%= totalDownloads %>
        </div>
      </div>

      <div class="glass" style="padding: 16px; border-radius: 12px;">
        <div class="muted" style="font-size: 0.85rem; margin-bottom: 6px;">DRAFTS</div>
        <div style="font-size: 2rem; font-weight: 700; color: #f59e0b;">
          <%= draftCount %>
        </div>
      </div>
    </div>

    <!-- Content Table -->
    <h2>Your Content</h2>
    
    <% if (contentList.length === 0) { %>
      <div style="text-align: center; padding: 40px 20px; background: var(--glass); border-radius: 12px;">
        <div style="font-size: 2rem; margin-bottom: 12px;">📭</div>
        <p class="muted">You haven't uploaded any content yet.</p>
        <a href="/marketplace/upload" class="btn" style="margin-top: 12px;">Start uploading</a>
      </div>
    <% } else { %>
      <div style="overflow-x: auto;">
        <table class="admin-list" style="width: 100%; border-collapse: collapse; margin-bottom: 32px;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border-light); background: var(--glass);">
              <th style="padding: 12px; text-align: left; font-weight: 600;">Title</th>
              <th style="padding: 12px; text-align: center; font-weight: 600;">Status</th>
              <th style="padding: 12px; text-align: center; font-weight: 600;">Downloads</th>
              <th style="padding: 12px; text-align: center; font-weight: 600;">Rating</th>
              <th style="padding: 12px; text-align: center; font-weight: 600;">Uploaded</th>
              <th style="padding: 12px; text-align: center; font-weight: 600;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% contentList.forEach(item => { %>
              <tr style="border-bottom: 1px solid var(--border-light); hover { background: rgba(0,0,0,0.02); }">
                <td style="padding: 12px;">
                  <a href="/marketplace/<%= item.id %>" style="color: var(--accent-2); text-decoration: none; font-weight: 500;">
                    <%= item.title %>
                  </a>
                </td>
                <td style="padding: 12px; text-align: center;">
                  <span style="padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; background: <%= item.status === 'published' ? '#d1f2d9' : '#fef3c7' %>; color: <%= item.status === 'published' ? '#0f5f22' : '#92400e' %>;">
                    <%= item.status.toUpperCase() %>
                  </span>
                </td>
                <td style="padding: 12px; text-align: center;">
                  📥 <%= item.download_count %>
                </td>
                <td style="padding: 12px; text-align: center;">
                  <div style="display: flex; justify-content: center; gap: 2px;">
                    <% 
                      const r = Math.round(item.rating || 0);
                      for (let i = 0; i < 5; i++) { %>
                        <span style="color: <%= i < r ? '#fbbf24' : '#e5e7eb'; %>;">★</span>
                    <% } %>
                  </div>
                  <div class="muted" style="font-size: 0.75rem; margin-top: 4px;">
                    <%= item.rating ? item.rating.toFixed(1) : 'No' %> / 5
                  </div>
                </td>
                <td style="padding: 12px; text-align: center; font-size: 0.9rem; color: var(--muted);">
                  <%= new Date(item.created_at).toLocaleDateString() %>
                </td>
                <td style="padding: 12px; text-align: center;">
                  <a href="/marketplace/<%= item.id %>" class="btn ghost" style="padding: 6px 10px; font-size: 0.8rem; text-decoration: none;">View</a>
                  <% if (item.status === 'draft') { %>
                    <form method="post" action="/marketplace/<%= item.id %>/publish" style="display: inline;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn" style="padding: 6px 10px; font-size: 0.8rem; margin-left: 4px;">Publish</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <!-- Earnings Section (Placeholder) -->
    <div style="margin-top: 40px; padding-top: 40px; border-top: 1px solid var(--border-light);">
      <h2>Earnings</h2>
      <div style="padding: 20px; background: var(--bg-2); border-radius: 12px;">
        <p class="muted" style="margin: 0;">
          Earnings data and payouts coming soon. You'll earn 50–70% of each sale after platform and payment fees.
        </p>
      </div>
    </div>
  </section>
</main>

<style>
tr:hover {
  background: rgba(0,0,0,0.02);
}
</style>

<%- include('../partials/footer') %>

</body>
</html>
