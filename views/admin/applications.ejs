<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Applications - Admin</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/header') %>
    <main class="container">
  <section class="page glass">
    <h1>Teacher Applications</h1>
    <div class="list curved">
      <% apps.forEach(function(a){ %>
        <div class="item glass">
          <strong><%= a.name %></strong> (<%= a.email %>) - <%= a.phone %>
          <p><%= a.message %></p>
          <% if (a.cv_path) { %><p><a href="<%= a.cv_path %>" target="_blank">Download CV</a></p><% } %>
        </div>
      <% }) %>
    </div>
  </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
