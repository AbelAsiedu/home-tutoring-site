<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Login - The Modern Pedagogues</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/header') %>
    <main class="container">
      <section class="page glass">
        <h1>Admin Login</h1>
        <% if (typeof error !== 'undefined') { %><div class="notice error"><%= error %></div><% } %>
        <form method="post" class="auth-form curved">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input name="username" placeholder="Username" required>
          <div style="position:relative;display:flex;align-items:center">
            <input id="adminPassword" name="password" type="password" placeholder="Password" required style="padding-right:45px;flex:1">
            <button type="button" id="toggleBtn" style="position:absolute;right:10px;background:transparent;border:0;cursor:pointer;padding:8px;font-size:20px;line-height:1;user-select:none;z-index:10" aria-label="Toggle password visibility" title="Show or hide password">
              <span id="eyeIcon">👁️</span>
            </button>
          </div>
          <button type="submit" title="Sign in as administrator">Login</button>
        </form>
        <script>
          (function(){
            const toggleBtn = document.getElementById('toggleBtn');
            const input = document.getElementById('adminPassword');
            const icon = document.getElementById('eyeIcon');
            if (toggleBtn && input && icon) {
              toggleBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                if (input.type === 'password') {
                  input.type = 'text';
                  icon.textContent = '🙈';
                } else {
                  input.type = 'password';
                  icon.textContent = '👁️';
                }
              });
            }
          })();
        </script>
      </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
