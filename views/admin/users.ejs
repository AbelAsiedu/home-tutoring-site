<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Management | Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('../partials/header') %>

<section class="page glass">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h1>User Management</h1>
    <div class="arrow-nav">
      <button onclick="history.back()" class="arrow-btn">←</button>
      <button onclick="history.forward()" class="arrow-btn">→</button>
    </div>
  </div>

  <% if (typeof message !== 'undefined') { %>
    <div class="notice success"><%= message %></div>
  <% } %>
  <% if (typeof error !== 'undefined') { %>
    <div class="notice error"><%= error %></div>
  <% } %>

  <div class="admin-section">
    <h2>Create New User</h2>
    <form method="post" action="/admin/users/create" class="auth-form curved">
      <input name="name" placeholder="Full name" required>
      <input name="email" type="email" placeholder="Email" required>
      <input name="password" type="password" placeholder="Temporary Password" required>
      <label style="margin-top:12px">Account Type</label>
      <select name="role" required>
        <option value="user">Student/Parent</option>
        <option value="tutor">Tutor</option>
      </select>
      <button type="submit">Create User Account</button>
    </form>
  </div>

  <div class="admin-section" style="margin-top:40px;">
    <h2>All Users</h2>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Password</th>
          <th>Role</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (users && users.length > 0) { %>
          <% users.forEach(function(user) { %>
            <tr>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
              <td style="word-break: break-all; font-size: 12px;">
                <% if (user.plain_password) { %>
                  <%= user.plain_password %>
                <% } else { %>
                  <em style="color: #999;">(Hashed - use Reset Password)</em>
                <% } %>
              </td>
              <td><%= user.role || 'user' %></td>
              <td>
                <form method="post" action="/admin/users/reset-password" style="display:inline;">
                  <input type="hidden" name="userId" value="<%= user.id %>">
                  <input type="text" name="newPassword" placeholder="New password" required style="width:120px; padding:4px;">
                  <button type="submit" style="background:#ffc107; color:#000;">Reset</button>
                </form>
                <form method="post" action="/admin/users/delete" style="display:inline;">
                  <input type="hidden" name="userId" value="<%= user.id %>">
                  <button type="submit" onclick="return confirm('Delete this user?')" style="background:#dc3545;">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="5" style="text-align:center;">No users found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/footer') %>

</body>
</html>
