<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Products - Admin</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/header') %>
    <main class="container">
  <section class="page glass">
    <h1>Manage Products</h1>
    <% if (message) { %>
      <div class="alert success"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>
    <form action="/admin/products" method="post" enctype="multipart/form-data" class="product-form curved">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="title" placeholder="Title" required>
      <input name="price" placeholder="Price" required type="number" min="0" step="0.01">
      <input name="description" placeholder="Description">
      <input type="file" name="image" accept="image/*">
      <button type="submit">Add Product</button>
    </form>
    <div class="glass" style="margin-top:16px;padding:12px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <h3 style="margin:0">All Products</h3>
        <a class="btn ghost" href="/admin/export/products">Export CSV</a>
      </div>
      <table class="admin-list" style="margin-top:10px">
        <thead>
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Price</th>
            <th>Description</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(p){ %>
            <tr>
              <td>
                <% if (p.image_path) { %>
                  <img src="<%= p.image_path %>" alt="image" style="width:60px;height:40px;object-fit:cover;border-radius:6px">
                <% } else { %>
                  <span class="muted">No image</span>
                <% } %>
              </td>
              <td><%= p.title %></td>
              <td>GHS <%= p.price %></td>
              <td class="muted" style="max-width:320px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= p.description %></td>
              <td>
                <form method="post" action="/admin/products/<%= p.id %>/update" enctype="multipart/form-data" style="display:grid;grid-template-columns:repeat(5,1fr);gap:6px;align-items:center">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input name="title" value="<%- p.title %>" placeholder="Title">
                  <input name="price" value="<%- p.price %>" placeholder="Price" type="number" step="0.01">
                  <input name="image_path" value="<%- p.image_path %>" placeholder="Image URL">
                  <input name="description" value="<%- p.description %>" placeholder="Description">
                  <input type="file" name="image" accept="image/*" aria-label="Upload new image">
                  <button type="submit" class="btn">Save</button>
                </form>
                <form method="post" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Delete this product?')" style="margin-top:6px">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn" style="background:#dc3545">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
