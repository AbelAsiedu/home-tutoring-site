<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Products - Admin</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/header') %>
    <main class="container">
  <section class="page glass">
    <h1>Manage Products</h1>
    <% if (message) { %>
      <div class="alert success"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">
      <!-- Physical Products Section -->
      <div class="glass" style="padding:16px">
        <h3 style="margin-top:0">📦 Add Physical Product</h3>
        <form action="/admin/products" method="post" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="is_downloadable" value="0">
          <input name="title" placeholder="Product Title" required style="margin-bottom:8px;width:100%;padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="price" placeholder="Price (GHS)" required type="number" min="0" step="0.01" style="margin-bottom:8px;width:100%;padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="description" placeholder="Description" style="margin-bottom:8px;width:100%;padding:8px;border:1px solid #ddd;border-radius:4px;min-height:60px">
          <label style="display:block;margin-bottom:8px;cursor:pointer">
            <span style="font-size:0.9rem;color:#666">Product Image:</span>
            <input type="file" name="image" accept="image/*" style="margin-top:4px;width:100%">
          </label>
          <button type="submit" style="width:100%;padding:10px;background:#007bff;color:white;border:none;border-radius:4px;cursor:pointer;font-weight:bold" title="Add a new physical product">Add Product</button>
        </form>
      </div>

      <!-- Downloadable Books Section -->
      <div class="glass" style="padding:16px;background:linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%)">
        <h3 style="margin-top:0">📚 Add Downloadable Book</h3>
        <form action="/admin/products" method="post" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="is_downloadable" value="1">
          <input name="title" placeholder="Book Title" required style="margin-bottom:8px;width:100%;padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="price" placeholder="Price (GHS)" required type="number" min="0" step="0.01" style="margin-bottom:8px;width:100%;padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="description" placeholder="Description" style="margin-bottom:8px;width:100%;padding:8px;border:1px solid #ddd;border-radius:4px;min-height:60px">
          <label style="display:block;margin-bottom:8px;cursor:pointer">
            <span style="font-size:0.9rem;color:#666">Book Cover Image:</span>
            <input type="file" name="image" accept="image/*" style="margin-top:4px;width:100%">
          </label>
          <label style="display:block;margin-bottom:8px;cursor:pointer">
            <span style="font-size:0.9rem;color:#d9534f;font-weight:bold">Book File (PDF/EPUB):</span>
            <input type="file" name="file" accept=".pdf,.epub,.zip" required style="margin-top:4px;width:100%" title="Upload the book file (PDF, EPUB, or ZIP)">
          </label>
          <button type="submit" style="width:100%;padding:10px;background:#28a745;color:white;border:none;border-radius:4px;cursor:pointer;font-weight:bold" title="Add a new downloadable book to the store">Add Book</button>
        </form>
      </div>
    </div>
    <div class="glass" style="margin-top:16px;padding:12px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <h3 style="margin:0">All Products & Books</h3>
        <a class="btn ghost" href="/admin/export/products" title="Download product list as CSV file">Export CSV</a>
      </div>
      <table class="admin-list" style="margin-top:10px">
        <thead>
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Price</th>
            <th>Type</th>
            <th>File</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(p){ %>
            <tr style="<%= p.is_downloadable ? 'background-color:#f9f9f9' : '' %>">
              <td>
                <% if (p.image_path) { %>
                  <img src="<%= p.image_path %>" alt="image" style="width:60px;height:40px;object-fit:cover;border-radius:6px">
                <% } else { %>
                  <span class="muted">No image</span>
                <% } %>
              </td>
              <td style="font-weight:<%= p.is_downloadable ? 'bold' : 'normal' %>"><%= p.title %></td>
              <td>GHS <%= p.price %></td>
              <td>
                <span style="font-size:0.85rem;padding:4px 8px;border-radius:4px;<%= p.is_downloadable ? 'background:#d4edda;color:#155724' : 'background:#e2e3e5;color:#383d41' %>">
                  <%= p.is_downloadable ? '📚 Book' : '📦 Product' %>
                </span>
              </td>
              <td>
                <% if (p.is_downloadable) { %>
                  <% if (p.file_path) { %>
                    <span style="font-size:0.85rem;color:#28a745;font-weight:bold" title="File is uploaded">✓ Uploaded</span><br>
                    <span class="muted" style="font-size:0.75rem"><%= p.file_path.substring(p.file_path.lastIndexOf('-')+1) %></span>
                  <% } else { %>
                    <span style="font-size:0.85rem;color:#dc3545" title="No file uploaded">✗ No file</span>
                  <% } %>
                <% } else { %>
                  <span class="muted">-</span>
                <% } %>
              </td>
              <td>
                <form method="post" action="/admin/products/<%= p.id %>/update" enctype="multipart/form-data" style="display:grid;grid-template-columns:repeat(5,1fr);gap:6px;align-items:center;margin-bottom:6px">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input name="title" value="<%- p.title %>" placeholder="Title" required>
                  <input name="price" value="<%- p.price %>" placeholder="Price" type="number" step="0.01" required>
                  <input name="description" value="<%- p.description || '' %>" placeholder="Description">
                  <input type="file" name="image" accept="image/*" aria-label="Upload new image">
                  <% if (p.is_downloadable) { %>
                    <input type="file" name="file" accept=".pdf,.epub,.zip" aria-label="Upload new file">
                  <% } else { %>
                    <input type="hidden" name="is_downloadable" value="0">
                  <% } %>
                  <input name="image_path" type="hidden" value="<%- p.image_path || '' %>">
                  <input name="file_path" type="hidden" value="<%- p.file_path || '' %>">
                  <input type="hidden" name="is_downloadable" value="<%= p.is_downloadable ? 1 : 0 %>">
                  <button type="submit" class="btn" style="background:#007bff;padding:6px" title="Save changes">Save</button>
                </form>
                <form method="post" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Delete this <%= p.is_downloadable ? 'book' : 'product' %>?')" style="margin-top:0">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn" style="background:#dc3545;width:100%;padding:6px;font-size:0.85rem" title="Delete this product">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (products.length === 0) { %>
        <div style="text-align:center;padding:20px;color:#999">
          <p>No products or books yet. Create one using the forms above!</p>
        </div>
      <% } %>
    </div>
  </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
