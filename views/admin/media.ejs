<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Media, Tutors & Banners - Admin</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .manager{display:grid;gap:18px}.manager-card{padding:18px}.toolbar{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap}.list{display:grid;gap:12px;margin-top:12px}.item{border:1px solid #dbe3ee;border-radius:12px;padding:14px;background:rgba(255,255,255,.65)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}.field{display:grid;gap:6px}.field label{font-weight:600}.field input,.field textarea,.field select{width:100%;box-sizing:border-box;padding:9px 10px;border:1px solid #d5dce6;border-radius:8px}.field textarea{min-height:80px;resize:vertical}.preview{width:100%;height:150px;object-fit:cover;border-radius:9px;background:#eef2f7}.avatar{width:90px;height:90px;border-radius:50%;object-fit:cover}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.danger{background:#dc3545!important;color:#fff!important}.muted-small{font-size:.86rem;color:#64748b}.empty{padding:20px;text-align:center;border:1px dashed #cbd5e1;border-radius:10px;color:#64748b}.success{color:#0a6c3d;background:#e6f4ea;padding:10px;border-radius:8px}.error{color:#b00020;background:#fdecef;padding:10px;border-radius:8px}
  </style>
</head>
<body>
<%- include('../partials/header') %>
<main class="container">
<section class="page glass manager">
  <div class="toolbar">
    <div><h1 style="margin-bottom:4px">Media, Tutors & Hero Banners</h1><p class="muted" style="margin:0">Manage the images, public tutor profiles and hero banners without editing code.</p></div>
    <a href="/admin" class="btn ghost">Back to Dashboard</a>
  </div>

  <% if (message) { %><div class="success"><%= message %></div><% } %>
  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <section class="manager-card glass">
    <h2>1. Upload an Image</h2>
    <p class="muted">Upload tutor photographs or banner artwork. After upload, the image becomes selectable below.</p>
    <form action="/admin/media/upload" method="post" enctype="multipart/form-data" style="display:flex;gap:10px;align-items:end;flex-wrap:wrap">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field" style="flex:1;min-width:240px"><label for="fileInput">Image</label><input id="fileInput" type="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" required></div>
      <button class="btn" type="submit">Upload Image</button>
    </form>
  </section>

  <section class="manager-card glass">
    <div class="toolbar"><div><h2>2. Hero Banners</h2><p class="muted">Create banners for the homepage and the Tutors page. Use the image selector to choose an uploaded image.</p></div><button class="btn" type="button" onclick="addBanner('home')">+ Add Home Banner</button></div>
    <div class="actions" style="margin-bottom:12px"><button class="btn ghost" type="button" onclick="addBanner('tutors')">+ Add Tutors Banner</button></div>
    <div id="homeBanners" class="list"></div>
    <h3 style="margin-top:22px">Tutors Page Banners</h3>
    <div id="tutorBanners" class="list"></div>
    <div class="actions"><button class="btn" type="button" onclick="saveBanners()">Save All Hero Banners</button></div>
  </section>

  <section class="manager-card glass">
    <div class="toolbar"><div><h2>3. Tutor Profiles</h2><p class="muted">Add, edit, reorder, publish or remove tutors. Changes appear on the public Tutors page after saving.</p></div><button class="btn" type="button" onclick="addTutor()">+ Add Tutor</button></div>
    <div id="tutorsList" class="list"></div>
    <div class="actions"><button class="btn" type="button" onclick="saveTutors()">Save Tutor Profiles</button></div>
  </section>

  <section class="manager-card glass">
    <h2>4. Existing Uploaded Media</h2>
    <p class="muted-small">These files are available to select for tutor photos and banners.</p>
    <div class="grid-3" style="margin-top:12px">
      <% if (files && files.length) { files.forEach(function(f){ const name=f.split('/').pop(); %>
        <div class="item"><img class="preview" src="<%= f %>" alt="<%= name %>"><div style="margin-top:6px;word-break:break-all"><code><%= name %></code></div><div class="actions"><button type="button" class="btn ghost" onclick="copyUrl('<%= f.replace(/'/g, "\\'") %>')">Copy URL</button><form method="post" action="/admin/media/delete" onsubmit="return confirm('Delete this image?')" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="path" value="<%= f %>"><button class="btn danger" type="submit">Delete</button></form></div></div>
      <% }) } else { %><div class="empty">No uploaded images yet.</div><% } %>
    </div>
  </section>

  <section class="manager-card glass">
    <h2>5. Existing Page Slides</h2>
    <p class="muted">Legacy slideshow slots remain available for Home, Tutors, Curriculum and About.</p>
    <% const pages=['home','tutors','curriculum','about']; pages.forEach(function(page){ %>
      <div style="margin-top:16px"><h3><%= page.charAt(0).toUpperCase()+page.slice(1) %></h3><div class="grid">
        <% ['slide_1','slide_2','slide_3'].forEach(function(slide){ const key=page+'_'+slide; %>
          <form method="post" action="/admin/content" class="item"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="key" value="<%= key %>"><input type="hidden" name="redirect_to" value="/admin/media"><div class="field"><label><%= slide %></label><input name="value" value="<%= (mediaValues && mediaValues[key]) || '' %>" placeholder="/uploads/image.jpg"></div><button class="btn" type="submit">Save</button></form>
        <% }) %>
      </div></div>
    <% }) %>
  </section>
</section>
</main>
<%- include('../partials/footer') %>
<script>
const csrfToken = <%- JSON.stringify(csrfToken || '') %>;
const uploadedImages = <%- JSON.stringify(files || []) %>;
let homeBanners = parseJson(<%- JSON.stringify(mediaValues && mediaValues.hero_banners_json || '[]') %>);
let tutorBanners = parseJson(<%- JSON.stringify(mediaValues && mediaValues.tutors_hero_banners_json || '[]') %>);
let tutors = parseJson(<%- JSON.stringify(mediaValues && mediaValues.tutors_json || '[]') %>);

function parseJson(value){ try { const v=JSON.parse(value||'[]'); return Array.isArray(v)?v:[]; } catch(e){ return []; } }
function esc(value){ return String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function imageOptions(selected){ return '<option value="">Select uploaded image…</option>'+uploadedImages.map(x=>`<option value="${esc(x)}" ${x===selected?'selected':''}>${esc(x.split('/').pop())}</option>`).join(''); }
function addBanner(type){ (type==='home'?homeBanners:tutorBanners).push({image:'',title:'',subtitle:'',buttonText:'',buttonUrl:'',active:true}); renderBanners(); }
function move(arr,i,delta){ const j=i+delta; if(j<0||j>=arr.length)return; [arr[i],arr[j]]=[arr[j],arr[i]]; }
function renderBanners(){ renderBannerList('homeBanners',homeBanners); renderBannerList('tutorBanners',tutorBanners); }
function renderBannerList(id,arr){ const el=document.getElementById(id); if(!arr.length){el.innerHTML='<div class="empty">No banners yet. Click Add Banner to create one.</div>';return;} el.innerHTML=arr.map((b,i)=>`<div class="item"><div class="grid"><div class="field"><label>Image</label><select data-type="banner" data-i="${i}" data-field="image">${imageOptions(b.image)}</select></div><div class="field"><label>Heading</label><input data-type="banner" data-i="${i}" data-field="title" value="${esc(b.title)}" placeholder="Featured tutoring"></div><div class="field"><label>Subtitle</label><input data-type="banner" data-i="${i}" data-field="subtitle" value="${esc(b.subtitle)}" placeholder="What should visitors know?"></div><div class="field"><label>Button text</label><input data-type="banner" data-i="${i}" data-field="buttonText" value="${esc(b.buttonText)}" placeholder="Learn more"></div><div class="field"><label>Button URL</label><input data-type="banner" data-i="${i}" data-field="buttonUrl" value="${esc(b.buttonUrl)}" placeholder="/contact"></div><div class="field"><label>Status</label><select data-type="banner" data-i="${i}" data-field="active"><option value="true" ${b.active!==false?'selected':''}>Published</option><option value="false" ${b.active===false?'selected':''}>Hidden</option></select></div></div><div class="actions"><button class="btn ghost" type="button" onclick="moveBanner('${id}',${i},-1)">↑</button><button class="btn ghost" type="button" onclick="moveBanner('${id}',${i},1)">↓</button><button class="btn danger" type="button" onclick="removeBanner('${id}',${i})">Remove</button></div></div>`).join(''); }
function moveBanner(id,i,d){const a=id==='homeBanners'?homeBanners:tutorBanners;move(a,i,d);renderBanners();}
function removeBanner(id,i){const a=id==='homeBanners'?homeBanners:tutorBanners;if(confirm('Remove this banner?')){a.splice(i,1);renderBanners();}}
function addTutor(){tutors.push({name:'',role:'',subjects:'',qualifications:'',experience:'',levels:'',location:'',bio:'',image:'',profileUrl:'',active:true});renderTutors();}
function renderTutors(){const el=document.getElementById('tutorsList');if(!tutors.length){el.innerHTML='<div class="empty">No tutors configured. Click Add Tutor to create the first profile.</div>';return;}el.innerHTML=tutors.map((t,i)=>`<div class="item"><div class="grid"><div class="field"><label>Photo</label><select data-type="tutor" data-i="${i}" data-field="image">${imageOptions(t.image)}</select></div><div class="field"><label>Name *</label><input data-type="tutor" data-i="${i}" data-field="name" value="${esc(t.name)}" placeholder="Tutor name"></div><div class="field"><label>Professional title</label><input data-type="tutor" data-i="${i}" data-field="role" value="${esc(t.role)}" placeholder="Senior Mathematics Tutor"></div><div class="field"><label>Subjects</label><input data-type="tutor" data-i="${i}" data-field="subjects" value="${esc(t.subjects)}" placeholder="Mathematics, Physics"></div><div class="field"><label>Qualifications</label><input data-type="tutor" data-i="${i}" data-field="qualifications" value="${esc(t.qualifications)}" placeholder="BSc, PGDE…"></div><div class="field"><label>Experience</label><input data-type="tutor" data-i="${i}" data-field="experience" value="${esc(t.experience)}" placeholder="5+ years"></div><div class="field"><label>Teaching levels</label><input data-type="tutor" data-i="${i}" data-field="levels" value="${esc(t.levels)}" placeholder="Primary, JHS, SHS"></div><div class="field"><label>Location</label><input data-type="tutor" data-i="${i}" data-field="location" value="${esc(t.location)}" placeholder="Accra / Online"></div><div class="field"><label>Profile URL (optional)</label><input data-type="tutor" data-i="${i}" data-field="profileUrl" value="${esc(t.profileUrl)}" placeholder="/tutors/…"></div><div class="field"><label>Status</label><select data-type="tutor" data-i="${i}" data-field="active"><option value="true" ${t.active!==false?'selected':''}>Published</option><option value="false" ${t.active===false?'selected':''}>Hidden</option></select></div><div class="field" style="grid-column:1/-1"><label>Biography</label><textarea data-type="tutor" data-i="${i}" data-field="bio" placeholder="Short professional biography">${esc(t.bio)}</textarea></div></div><div class="actions"><button class="btn ghost" type="button" onclick="moveTutor(${i},-1)">↑ Move Up</button><button class="btn ghost" type="button" onclick="moveTutor(${i},1)">↓ Move Down</button><button class="btn danger" type="button" onclick="removeTutor(${i})">Remove Tutor</button></div></div>`).join('');}
function moveTutor(i,d){move(tutors,i,d);renderTutors();}
function removeTutor(i){if(confirm('Remove this tutor from the public Tutors page?')){tutors.splice(i,1);renderTutors();}}
function syncFields(){document.querySelectorAll('[data-type]').forEach(el=>{const i=Number(el.dataset.i);const field=el.dataset.field;const target=el.dataset.type==='tutor'?tutors[i]:(el.closest('#homeBanners')?homeBanners[i]:tutorBanners[i]);if(!target)return;target[field]=field==='active'?el.value==='true':el.value;});}
async function saveContent(key,value){const body=new URLSearchParams({_csrf:csrfToken,key,value,redirect_to:'/admin/media'});const r=await fetch('/admin/content',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','Accept':'application/json'},body});if(!r.ok)throw new Error('Save failed');}
async function saveBanners(){syncFields();try{await saveContent('hero_banners_json',JSON.stringify(homeBanners));await saveContent('tutors_hero_banners_json',JSON.stringify(tutorBanners));alert('Hero banners saved successfully.');}catch(e){alert('Could not save hero banners. Please refresh and try again.');}}
async function saveTutors(){syncFields();if(tutors.some(t=>t.active!==false&&!String(t.name||'').trim())){alert('Every published tutor needs a name.');return;}try{await saveContent('tutors_json',JSON.stringify(tutors));alert('Tutor profiles saved successfully.');}catch(e){alert('Could not save tutor profiles. Please refresh and try again.');}}
function copyUrl(url){navigator.clipboard?.writeText(url).then(()=>alert('URL copied.')).catch(()=>prompt('Copy this URL:',url));}
document.addEventListener('change',e=>{if(e.target.dataset?.type){const i=Number(e.target.dataset.i),f=e.target.dataset.field;const a=e.target.dataset.type==='tutor'?tutors:(e.target.closest('#homeBanners')?homeBanners:tutorBanners);if(a[i])a[i][f]=f==='active'?e.target.value==='true':e.target.value;}});
document.addEventListener('input',e=>{if(e.target.dataset?.type){const i=Number(e.target.dataset.i),f=e.target.dataset.field;const a=e.target.dataset.type==='tutor'?tutors:(e.target.closest('#homeBanners')?homeBanners:tutorBanners);if(a[i])a[i][f]=e.target.value;}});
renderBanners();renderTutors();
</script>
</body>
</html>
