<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Content - Admin</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/header') %>
    <main class="container">
  <section class="page glass">
    <h1>Edit Site Content</h1>
    <div class="notice" style="margin-bottom:12px">
      Choose a page, pick a field, edit the text/HTML, click Save, then refresh the public page.
    </div>
    <div class="glass" style="margin-bottom:14px;padding:10px;display:grid;gap:10px">
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <label for="pagePicker" style="font-weight:600">Page</label>
        <select id="pagePicker" style="padding:8px 10px;border:1px solid #e2e8f0;border-radius:8px;min-width:220px">
          <option value="home">Home</option>
          <option value="about">About</option>
          <option value="faq">FAQ</option>
          <option value="tutors">Tutors</option>
          <option value="curriculum">Curriculum</option>
          <option value="slides">Slides</option>
          <option value="misc">Other</option>
        </select>
        <label for="modePicker" style="font-weight:600">Mode</label>
        <select id="modePicker" style="padding:8px 10px;border:1px solid #e2e8f0;border-radius:8px;min-width:180px">
          <option value="page">Page HTML</option>
          <option value="field">Fields</option>
        </select>
      </div>
      <div id="keyChips" style="display:flex;flex-wrap:wrap;gap:8px"></div>
    </div>
    <form method="post" action="/admin/content" style="display:grid;gap:12px" id="contentForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="grid-2">
        <div class="form-group" id="keyInputGroup">
          <label for="key">Key (e.g. about_text, slide_1, curriculum_GES)</label>
          <input type="text" id="key" name="key" placeholder="content key" required />
        </div>
        <div class="form-group" id="valueGroup">
          <label for="value">Value (HTML allowed)</label>
          <textarea id="value" name="value" rows="6" placeholder="Enter text or HTML"></textarea>
        </div>
      </div>
      <button class="btn" type="submit">Save Content</button>
    </form>
    <% if (entries && entries.length) { %>
      <div class="glass" style="margin-top:20px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
          <h3 style="margin:0">Existing Entries</h3>
          <div style="display:flex;gap:8px;align-items:center">
            <input id="searchEntries" type="search" placeholder="Search key or value" style="padding:6px 10px;border:1px solid #e2e8f0;border-radius:8px;min-width:200px" />
            <span id="entryCount" style="font-size:13px;color:#555"></span>
          </div>
        </div>
        <table class="admin-list" id="entriesTable">
          <thead>
            <tr>
              <th>Key</th>
              <th style="width:70%">Value preview</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    <% } %>
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6.8.3/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
      const entries = <%- JSON.stringify(entries || []) %>;
      const pageKeys = {
        home: [
          'hero_title','hero_lead','hero_cta_primary','hero_cta_secondary','hero_badge_1','hero_badge_2','hero_badge_3',
          'booking_title','booking_copy','booking_contact',
          'feature_1_title','feature_1_body','feature_2_title','feature_2_body','feature_3_title','feature_3_body',
          'how_title','how_step1_title','how_step1_body','how_step2_title','how_step2_body','how_step3_title','how_step3_body',
          'platform_title','platform_1_title','platform_1_body','platform_2_title','platform_2_body','platform_3_title','platform_3_body',
          'assess_title','assess_body','safety_title','safety_body',
          'pricing_title','pricing_plan1_title','pricing_plan1_desc','pricing_plan1_price','pricing_plan1_cta',
          'pricing_plan2_title','pricing_plan2_desc','pricing_plan2_price','pricing_plan2_cta',
          'pricing_plan3_title','pricing_plan3_desc','pricing_plan3_price','pricing_plan3_cta',
          'testimonials_title','testimonial_1_body','testimonial_1_by','testimonial_2_body','testimonial_2_by',
          'approach_title','approach_1_title','approach_1_body','approach_2_title','approach_2_body','approach_3_title','approach_3_body',
          'subjects_title','subjects_1_title','subjects_1_body','subjects_2_title','subjects_2_body','subjects_3_title','subjects_3_body','subjects_4_title','subjects_4_body','subjects_5_title','subjects_5_body','subjects_6_title','subjects_6_body',
          'trust_title','trust_body','trust_badge_1','trust_badge_2','trust_badge_3'
        ],
        about: ['about_title','about_body','about_why_title','about_why_1','about_why_2','about_why_3'],
        faq: ['faq_title','faq_q1','faq_a1','faq_q2','faq_a2','faq_q3','faq_a3'],
        tutors: ['tutors_title','tutors_intro','tutor_1_name','tutor_1_role','tutor_2_name','tutor_2_role','tutor_3_name','tutor_3_role','tutor_4_name','tutor_4_role','tutor_5_name','tutor_5_role','tutor_6_name','tutor_6_role'],
        curriculum: ['curriculum_GES','curriculum_Cambridge','curriculum_IGCSE','curriculum_waec','curriculum_notes'],
        slides: ['slide_1','slide_2','slide_3'],
        misc: ['contact_phone','contact_whatsapp','contact_email','footer_privacy','navbar_cta','apply_intro','estore_intro','resources_intro']
      };

      const entryMap = entries.reduce((acc, cur) => {
        acc[cur.key] = cur.value;
        return acc;
      }, {});

      const keyInput = document.getElementById('key');
      const keyChips = document.getElementById('keyChips');
      const pagePicker = document.getElementById('pagePicker');
      const modePicker = document.getElementById('modePicker');
      const keyInputGroup = document.getElementById('keyInputGroup');
      const valueGroup = document.getElementById('valueGroup');
      // dynamic field dropdown for selected page
      const fieldPicker = document.createElement('select');
      fieldPicker.id = 'fieldPicker';
      fieldPicker.style.cssText = 'padding:8px 10px;border:1px solid #e2e8f0;border-radius:8px;min-width:220px;';
      const fieldLabel = document.createElement('label');
      fieldLabel.htmlFor = 'fieldPicker';
      fieldLabel.textContent = 'Field';
      fieldLabel.style.fontWeight = '600';
      // insert field picker next to page picker
      const pickersRow = document.querySelector('.glass > div');
      if (pickersRow) {
        pickersRow.appendChild(fieldLabel);
        pickersRow.appendChild(fieldPicker);
      }
      const entryCount = document.getElementById('entryCount');
      const searchBox = document.getElementById('searchEntries');
      const tableBody = document.querySelector('#entriesTable tbody');

      let editorReady = false;
      let pendingContent = '';
      if (window.tinymce) {
        tinymce.init({
          selector: '#value',
          height: 320,
          menubar: false,
          plugins: 'link lists code table',
          toolbar: 'undo redo | bold italic underline | bullist numlist | link table | code',
          setup: (ed) => {
            ed.on('init', () => {
              editorReady = true;
              if (pendingContent) {
                ed.setContent(pendingContent);
                pendingContent = '';
              }
              renderTable(entries);
              // Apply mode after editor ready
              if (modePicker) {
                const applyMode = () => {
                  const isPage = modePicker.value === 'page';
                  if (keyInputGroup) keyInputGroup.style.display = isPage ? 'none' : '';
                  if (keyChips) keyChips.style.display = isPage ? 'none' : '';
                  if (fieldPicker) fieldPicker.style.display = isPage ? 'none' : '';
                  if (fieldLabel) fieldLabel.style.display = isPage ? 'none' : '';
                  if (isPage) {
                    setEditorContent(buildPageHtml(pagePicker ? pagePicker.value : 'home'));
                  } else {
                    renderKeyControls(pagePicker ? pagePicker.value : 'home');
                  }
                };
                modePicker.addEventListener('change', applyMode);
                applyMode();
              }
            });
          }
        });
      } else {
        // Fallback: no TinyMCE available, proceed with plain textarea
        editorReady = true;
        renderTable(entries);
        if (modePicker) {
          const applyMode = () => {
            const isPage = modePicker.value === 'page';
            if (keyInputGroup) keyInputGroup.style.display = isPage ? 'none' : '';
            if (keyChips) keyChips.style.display = isPage ? 'none' : '';
            if (fieldPicker) fieldPicker.style.display = isPage ? 'none' : '';
            if (fieldLabel) fieldLabel.style.display = isPage ? 'none' : '';
            if (isPage) {
              setEditorContent(buildPageHtml(pagePicker ? pagePicker.value : 'home'));
            } else {
              renderKeyControls(pagePicker ? pagePicker.value : 'home');
            }
          };
          modePicker.addEventListener('change', applyMode);
          applyMode();
        }
      }

      // Defaults shown on public pages when DB is empty
      const defaultMap = {
        hero_title: 'Personalised tutoring that builds confident learners',
