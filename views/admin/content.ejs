<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Content - Admin</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/header') %>
    <main class="container">
  <section class="page glass">
    <h1>Edit Site Content</h1>
    <div class="notice" style="margin-bottom:12px">
      Pick a key, edit the text/HTML, click Save, then refresh the public page. You can also click any existing entry below to load it.
    </div>
    <div class="glass" style="margin-bottom:14px;padding:10px;display:grid;gap:8px">
      <strong>Quick keys (click to load)</strong>
      <div style="display:grid;gap:6px">
        <div><em>Home</em>:
          <button type="button" class="btn ghost" data-key="hero_title">hero_title</button>
          <button type="button" class="btn ghost" data-key="hero_lead">hero_lead</button>
          <button type="button" class="btn ghost" data-key="pricing_plan1_price">pricing_plan1_price</button>
          <button type="button" class="btn ghost" data-key="testimonial_1_body">testimonial_1_body</button>
        </div>
        <div><em>About</em>: <button type="button" class="btn ghost" data-key="about_body">about_body</button></div>
        <div><em>FAQ</em>: <button type="button" class="btn ghost" data-key="faq_q1">faq_q1</button> <button type="button" class="btn ghost" data-key="faq_a1">faq_a1</button></div>
        <div><em>Tutors</em>: <button type="button" class="btn ghost" data-key="tutor_1_name">tutor_1_name</button> <button type="button" class="btn ghost" data-key="tutor_1_role">tutor_1_role</button></div>
        <div><em>Curriculum</em>: <button type="button" class="btn ghost" data-key="curriculum_GES">curriculum_GES</button> <button type="button" class="btn ghost" data-key="curriculum_Cambridge">curriculum_Cambridge</button></div>
        <div><em>Slides</em>: <button type="button" class="btn ghost" data-key="slide_1">slide_1</button> <button type="button" class="btn ghost" data-key="slide_2">slide_2</button></div>
      </div>
    </div>
    <form action="/admin/content" method="post" class="curved">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Key (e.g. about_text, slide_1, curriculum_GES)</label>
      <input name="key" required>
      <label>Value (HTML allowed)</label>
      <textarea id="editor" name="value"></textarea>
      <button type="submit">Save Content</button>
    </form>
    <% if (entries && entries.length) { %>
      <div class="glass" style="margin-top:16px;padding:12px">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
          <h3 style="margin:0">Existing entries</h3>
          <input type="search" id="entrySearch" placeholder="Filter keys" style="padding:8px 10px;border:1px solid #e2e8f0;border-radius:8px;min-width:200px">
        </div>
        <table class="admin-list" id="entriesTable">
          <thead>
            <tr>
              <th>Key</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% entries.forEach(function(e){ %>
              <tr>
                <td><strong><%= e.key %></strong></td>
                <td style="display:flex;gap:8px">
                  <button class="btn" onclick="fillEditor('<%- e.key %>', `<%- (e.value||'').replace(/`/g,'\\`') %>`)") type="button">Edit</button>
                  <form method="post" action="/admin/content/delete" onsubmit="return confirm('Delete this entry?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="key" value="<%- e.key %>">
                    <button class="btn" style="background:#dc3545" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
    <!-- Self-hosted TinyMCE (no API key required) -->
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6.8.3/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
      tinymce.init({ selector: '#editor', height: 320, menubar: false, plugins: 'link lists code table', toolbar: 'undo redo | bold italic underline | bullist numlist | link table | code' });
      function fillEditor(key, val){
        document.querySelector('input[name=key]').value = key;
        const editor = tinymce.get('editor');
        if (editor) { editor.setContent(val || ''); }
        else { document.getElementById('editor').value = val || ''; }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      // quick key buttons
      document.querySelectorAll('[data-key]').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-key');
          const entry = (window.entryMap || {})[key];
          fillEditor(key, entry || '');
        });
      });
      // build entry map for fast lookup and table filtering
      window.entryMap = {};
      <% (entries || []).forEach(function(e){ %>
        window.entryMap['<%- e.key %>'] = `<%- (e.value||'').replace(/`/g,'\\`') %>`;
      <% }); %>
      const search = document.getElementById('entrySearch');
      if (search) {
        search.addEventListener('input', function(){
          const term = this.value.toLowerCase();
          document.querySelectorAll('#entriesTable tbody tr').forEach(row => {
            const key = row.querySelector('td strong').textContent.toLowerCase();
            row.style.display = key.includes(term) ? '' : 'none';
          });
        });
      }
    </script>
  </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
