<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Content - Admin</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/header') %>
    <main class="container">
  <section class="page glass">
    <h1>Edit Site Content</h1>
    <div class="notice" style="margin-bottom:12px">
      Use the keys below to edit text on each public page without touching code. Enter the key, paste the new text/HTML, and click Save. Then refresh the public page to see it.
      <details style="margin-top:8px">
        <summary style="cursor:pointer">Suggested keys by page</summary>
        <div style="padding:8px 0;display:grid;gap:6px;font-size:0.95rem">
          <div><strong>Home:</strong> hero_title, hero_lead, hero_cta_primary, hero_cta_secondary, hero_badge_1/2/3, booking_title, booking_copy, booking_contact, feature_1/2/3_title, feature_1/2/3_body, how_title, how_step1/2/3_title, how_step1/2/3_body, platform_title, platform_1/2/3_title, platform_1/2/3_body, assess_title, assess_body, safety_title, safety_body, pricing_title, pricing_plan1/2/3_title, pricing_plan1/2/3_desc, pricing_plan1/2/3_price, pricing_plan1/2/3_cta, testimonials_title, testimonial_1/2_body, testimonial_1/2_by, approach_title, approach_1/2/3_title, approach_1/2/3_body, subjects_title, subjects_1..6_title, subjects_1..6_body, trust_title, trust_body, trust_badge_1/2/3.</div>
          <div><strong>About:</strong> about_title, about_body, about_why_title, about_why_1/2/3.</div>
          <div><strong>FAQ:</strong> faq_title, faq_q1/2/3, faq_a1/2/3.</div>
          <div><strong>Tutors:</strong> tutors_title, tutors_intro, tutor_1..6_name, tutor_1..6_role.</div>
          <div><strong>Curriculum:</strong> curriculum_GES, curriculum_Cambridge, curriculum_US, etc. (keys starting with curriculum_).</div>
          <div><strong>Slides:</strong> slide_1, slide_2, slide_3 (image URLs for homepage hero).</div>
          <div><strong>Anything else:</strong> create any new key you need; templates will show the default text if a key is missing.</div>
        </div>
      </details>
    </div>
    <form action="/admin/content" method="post" class="curved">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Key (e.g. about_text, slide_1, curriculum_GES)</label>
      <input name="key" required>
      <label>Value (HTML allowed)</label>
      <textarea id="editor" name="value"></textarea>
      <button type="submit">Save Content</button>
    </form>
    <% if (entries && entries.length) { %>
      <div class="glass" style="margin-top:16px;padding:12px">
        <h3>Existing entries</h3>
        <table class="admin-list">
          <thead>
            <tr>
              <th>Key</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% entries.forEach(function(e){ %>
              <tr>
                <td><strong><%= e.key %></strong></td>
                <td style="display:flex;gap:8px">
                  <button class="btn" onclick="fillEditor('<%- e.key %>', `<%- (e.value||'').replace(/`/g,'\\`') %>`)" type="button">Edit</button>
                  <form method="post" action="/admin/content/delete" onsubmit="return confirm('Delete this entry?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="key" value="<%- e.key %>">
                    <button class="btn" style="background:#dc3545" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
    <!-- Self-hosted TinyMCE (no API key required) -->
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6.8.3/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
      tinymce.init({ selector: '#editor', height: 320, menubar: false, plugins: 'link lists code table', toolbar: 'undo redo | bold italic underline | bullist numlist | link table | code' });
      function fillEditor(key, val){
        document.querySelector('input[name=key]').value = key;
        const editor = tinymce.get('editor');
        if (editor) { editor.setContent(val || ''); }
        else { document.getElementById('editor').value = val || ''; }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    </script>
  </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
