        testimonials_title: 'What parents say',
        testimonial_1_body: "Our daughter's confidence improved after just 6 lessons — highly recommended.",
        testimonial_1_by: '— Ama, Accra',
        testimonial_2_body: 'Great tutors and flexible scheduling — a lifesaver.',
        testimonial_2_by: '— Kofi, Kumasi',
        approach_title: 'Our approach to learning',
        approach_1_title: 'Personalised learning',
        approach_1_body: "We tailor lessons to each learner's goals and learning style, not a one-size-fits-all plan.",
        approach_2_title: 'Evidence-based practice',
        approach_2_body: 'Progress is guided by formative assessments and targeted feedback so time spent is effective.',
        approach_3_title: 'Curriculum-aligned',
        approach_3_body: 'Lessons and resources map to national and international curricula, from Primary through A-Levels.',
        subjects_title: 'Subjects we teach',
        subjects_1_title: 'Mathematics',
        subjects_1_body: 'Primary → A-Level',
        subjects_2_title: 'English',
        subjects_2_body: 'Comprehension, grammar & literature',
        subjects_3_title: 'Science',
        subjects_3_body: 'Physics, Chemistry & Biology',
        subjects_4_title: 'Computer Science',
        subjects_4_body: 'ICT, programming & digital skills',
        subjects_5_title: 'Accounting',
        subjects_5_body: 'Syllabus-aligned exam prep',
        subjects_6_title: 'Languages',
        subjects_6_body: 'French & other languages',
        trust_title: 'Safety, vetting & accreditation',
        trust_body: 'All tutors are background-checked and reviewed; we follow strong safeguarding procedures and quality assurance.',
        trust_badge_1: 'DBS-checked*',
        trust_badge_2: 'Certified tutors',
        trust_badge_3: 'Partner schools',
        about_title: 'About The Modern Pedagogues',
        about_body: 'The Modern Pedagogues was founded to bring quality home tutoring to families. Our tutors are experienced and vetted, and our lessons align with global curricula from GES to Cambridge and North American programs.',
        about_why_title: 'Why choose us?',
        about_why_1: 'Experienced tutors across curricula',
        about_why_2: 'Tailored lesson plans',
        about_why_3: 'Parent-friendly reporting and scheduling',
        faq_title: 'Frequently Asked Questions',
        faq_q1: 'What ages do you teach?',
        faq_a1: 'We teach learners from primary school through secondary and offer adult learning support.',
        faq_q2: 'Do you offer online lessons?',
        faq_a2: 'Yes — we offer both in-home and online lessons via video call.',
        faq_q3: 'How are tutors vetted?',
        faq_a3: 'All tutors supply references, undergo an interview, and are observed before joining our network.',
