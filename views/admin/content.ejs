        tutors_intro: 'All our tutors are vetted, experienced, and trained to deliver curriculum-aligned lessons.',
        tutor_1_name: 'Abel Asiedu',
        tutor_1_role: 'Senior Tutor • Mathematics',
        tutor_2_name: 'Christian Braun',
        tutor_2_role: 'Senior Tutor • Physics',
        tutor_3_name: 'Theophilus Banful',
        tutor_3_role: 'Senior Tutor • Chemistry',
        tutor_4_name: 'Stephen Okwa',
        tutor_4_role: 'Senior Tutor • English',
        tutor_5_name: 'Aaron Neesmith',
        tutor_5_role: 'Senior Tutor • Biology',
        tutor_6_name: 'Malvin Canva',
        tutor_6_role: 'Senior Tutor • Computer Science'
      };

      function setEditorContent(html) {
        const editor = (window.tinymce && tinymce.get('value')) || null;
        const content = (html != null && html !== '') ? html : '';
        if (editorReady && editor) {
          editor.setContent(content);
        } else {
          pendingContent = content;
          document.getElementById('value').value = content;
        }
      }

      function loadFieldEntry(key) {
        keyInput.value = key;
        const val = entryMap[key];
        const content = (val != null && val !== '') ? val : (defaultMap[key] || '');
        setEditorContent(content);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function buildPageHtml(page) {
        const get = (k) => (entryMap[k] != null && entryMap[k] !== '') ? entryMap[k] : (defaultMap[k] || '');
        if (page === 'home') {
          return `
<section class="hero">
  <h1 data-k="hero_title">${get('hero_title')}</h1>
  <p data-k="hero_lead">${get('hero_lead')}</p>
  <div>
    <a data-k="hero_cta_primary">${get('hero_cta_primary')}</a>
    <a data-k="hero_cta_secondary">${get('hero_cta_secondary')}</a>
  </div>
</section>
<section class="pricing">
  <h2 data-k="pricing_title">${get('pricing_title')}</h2>
  <div class="plans">
    <div class="plan">
      <h3 data-k="pricing_plan1_title">${get('pricing_plan1_title')}</h3>
      <div data-k="pricing_plan1_desc">${get('pricing_plan1_desc')}</div>
      <div data-k="pricing_plan1_price">${get('pricing_plan1_price')}</div>
    </div>
    <div class="plan">
      <h3 data-k="pricing_plan2_title">${get('pricing_plan2_title')}</h3>
      <div data-k="pricing_plan2_desc">${get('pricing_plan2_desc')}</div>
      <div data-k="pricing_plan2_price">${get('pricing_plan2_price')}</div>
    </div>
    <div class="plan">
      <h3 data-k="pricing_plan3_title">${get('pricing_plan3_title')}</h3>
      <div data-k="pricing_plan3_desc">${get('pricing_plan3_desc')}</div>
      <div data-k="pricing_plan3_price">${get('pricing_plan3_price')}</div>
    </div>
  </div>
</section>
<section class="testimonials">
  <h2 data-k="testimonials_title">${get('testimonials_title')}</h2>
  <div class="testimonial">
    <p data-k="testimonial_1_body">${get('testimonial_1_body')}</p>
    <div data-k="testimonial_1_by">${get('testimonial_1_by')}</div>
  </div>
  <div class="testimonial">
    <p data-k="testimonial_2_body">${get('testimonial_2_body')}</p>
    <div data-k="testimonial_2_by">${get('testimonial_2_by')}</div>
  </div>
</section>`;
        }
        if (page === 'about') {
          return `
<section class="page">
  <h1 data-k="about_title">${get('about_title')}</h1>
  <p data-k="about_body">${get('about_body')}</p>
  <h3 data-k="about_why_title">${get('about_why_title')}</h3>
  <ul>
    <li data-k="about_why_1">${get('about_why_1')}</li>
    <li data-k="about_why_2">${get('about_why_2')}</li>
    <li data-k="about_why_3">${get('about_why_3')}</li>
  </ul>
</section>`;
        }
        if (page === 'faq') {
          return `
<section class="faq">
  <h1 data-k="faq_title">${get('faq_title')}</h1>
