    <h4 data-k="faq_q1">${get('faq_q1')}</h4>
    <p data-k="faq_a1">${get('faq_a1')}</p>
    <h4 data-k="faq_q2">${get('faq_q2')}</h4>
    <p data-k="faq_a2">${get('faq_a2')}</p>
    <h4 data-k="faq_q3">${get('faq_q3')}</h4>
    <p data-k="faq_a3">${get('faq_a3')}</p>
  </div>
</section>`;
        }
        if (page === 'tutors') {
          return `
<section class="tutors">
  <h1 data-k="tutors_title">${get('tutors_title')}</h1>
  <p data-k="tutors_intro">${get('tutors_intro')}</p>
  <div class="tutors-grid">
    <div class="tutor">
      <h3 data-k="tutor_1_name">${get('tutor_1_name')}</h3>
      <div data-k="tutor_1_role">${get('tutor_1_role')}</div>
    </div>
    <div class="tutor">
      <h3 data-k="tutor_2_name">${get('tutor_2_name')}</h3>
      <div data-k="tutor_2_role">${get('tutor_2_role')}</div>
    </div>
    <div class="tutor">
      <h3 data-k="tutor_3_name">${get('tutor_3_name')}</h3>
      <div data-k="tutor_3_role">${get('tutor_3_role')}</div>
    </div>
    <div class="tutor">
      <h3 data-k="tutor_4_name">${get('tutor_4_name')}</h3>
      <div data-k="tutor_4_role">${get('tutor_4_role')}</div>
    </div>
    <div class="tutor">
      <h3 data-k="tutor_5_name">${get('tutor_5_name')}</h3>
      <div data-k="tutor_5_role">${get('tutor_5_role')}</div>
    </div>
    <div class="tutor">
      <h3 data-k="tutor_6_name">${get('tutor_6_name')}</h3>
      <div data-k="tutor_6_role">${get('tutor_6_role')}</div>
    </div>
  </div>
</section>`;
        }
        return '<p>Edit this page by switching Mode to Fields.</p>';
      }

      function parsePageHtml(html) {
        const container = document.createElement('div');
        container.innerHTML = html || '';
        const els = container.querySelectorAll('[data-k]');
        const items = [];
        els.forEach(el => {
          const k = el.getAttribute('data-k');
          if (k) items.push({ key: k, value: el.innerHTML.trim() });
        });
        return items;
      }

      function loadEntry(key) {
        keyInput.value = key;
        const val = entryMap[key];
        setEditorContent(val);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function renderTable(list) {
        if (!tableBody) return;
        tableBody.innerHTML = '';
        list.forEach(item => {
          const tr = document.createElement('tr');
          tr.dataset.key = item.key;
          const tdKey = document.createElement('td');
          tdKey.innerHTML = `<strong>${item.key}</strong>`;
          const tdVal = document.createElement('td');
          tdVal.textContent = (item.value || '').replace(/\s+/g, ' ').slice(0, 140) + ((item.value || '').length > 140 ? '…' : '');
          const tdActions = document.createElement('td');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn';
          btn.textContent = 'Edit';
          btn.addEventListener('click', () => loadFieldEntry(item.key));
          tdActions.appendChild(btn);
          const delForm = document.createElement('form');
          delForm.method = 'post';
          delForm.action = '/admin/content/delete';
          delForm.onsubmit = () => confirm('Delete this entry?');
          delForm.innerHTML = `<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="key" value="${item.key}"><button class="btn" style="background:#dc3545" type="submit">Delete</button>`;
          tdActions.appendChild(delForm);
          tr.appendChild(tdKey);
          tr.appendChild(tdVal);
          tr.appendChild(tdActions);
          tableBody.appendChild(tr);
        });
        if (entryCount) {
          entryCount.textContent = `${list.length} entries`;
        }
      }

      function keysForPage(page) {
        // combine static suggestions with heuristics from existing entries
        const heuristics = {
          home: ['hero','pricing','testimonial','cta'],
          about: ['about'],
          faq: ['faq'],
          tutors: ['tutor'],
          curriculum: ['curriculum'],
          slides: ['slide'],
          misc: []
        };
        const suggest = pageKeys[page] || [];
        const hints = heuristics[page] || [];
        const fromEntries = entries
          .map(e => e.key)
          .filter(k => hints.length ? hints.some(h => k.toLowerCase().includes(h)) : true);
        const all = Array.from(new Set([...suggest, ...fromEntries]));
        // for misc, exclude keys captured by other pages
        if (page === 'misc') {
          const other = new Set(Object.keys(pageKeys).filter(p => p !== 'misc').flatMap(p => pageKeys[p]));
          return all.filter(k => !other.has(k));
        }
        return all;
      }

      function renderKeyControls(page) {
        // chips
        keyChips.innerHTML = '';
        const keys = keysForPage(page);
        keys.forEach(k => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn ghost';
          btn.textContent = k;
          btn.addEventListener('click', () => loadFieldEntry(k));
          keyChips.appendChild(btn);
        });
        if (!keyChips.children.length) {
          const span = document.createElement('span');
          span.textContent = 'No keys found for this page yet.';
          span.style.color = '#666';
          keyChips.appendChild(span);
        }
        // field dropdown
        fieldPicker.innerHTML = '';
        keys.forEach(k => {
          const opt = document.createElement('option');
          opt.value = k;
          opt.textContent = k;
          fieldPicker.appendChild(opt);
        });
        if (keys.length) {
          fieldPicker.value = keys[0];
          loadFieldEntry(keys[0]);
        } else {
          setEditorContent('');
          keyInput.value = '';
        }
      }

      if (pagePicker) {
        pagePicker.addEventListener('change', () => {
          if (modePicker && modePicker.value === 'page') {
            setEditorContent(buildPageHtml(pagePicker.value));
          } else {
            renderKeyControls(pagePicker.value);
          }
        });
      }
      fieldPicker.addEventListener('change', () => loadFieldEntry(fieldPicker.value));

      if (searchBox) {
        searchBox.addEventListener('input', () => {
          const term = searchBox.value.toLowerCase();
          const filtered = entries.filter(e =>
            (e.key || '').toLowerCase().includes(term) || (e.value || '').toLowerCase().includes(term)
          );
          renderTable(filtered);
        });
      }



      // Intercept save for Page HTML mode and bulk update
      const contentForm = document.getElementById('contentForm');
      if (contentForm) {
        contentForm.addEventListener('submit', async (e) => {
          if (modePicker && modePicker.value === 'page') {
            e.preventDefault();
            const ed = (window.tinymce && tinymce.get('value')) || null;
            const html = ed ? ed.getContent() : (document.getElementById('value').value || '');
            const items = parsePageHtml(html);
            const csrf = '<%= csrfToken %>';
            try {
              await fetch('/admin/content/bulk', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ _csrf: csrf, items })
              });
              window.location.href = '/admin/content';
            } catch (err) {
              alert('Failed to save page content.');
            }
          }
        });
      }
    </script>
  </section>
</main>
<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
