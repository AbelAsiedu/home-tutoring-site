<%- include('partials/header') %>

<section class="page glass contact-page">
  <h1>Contact Us</h1>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="notice success">Message sent. We'll get back to you shortly.</div>
  <% } %>
  <div class="contact-grid curved">
    <div class="contact-info">
      <h3>Call & WhatsApp</h3>
      <p>Phone: +233 59 366 0708</p>
      <p>WhatsApp: <a href="https://wa.me/233593660708">+233 59 366 0708</a></p>
      <a class="btn" href="https://wa.me/233593660708?text=Hello%20TMP%2C%20I%20would%20like%20to%20get%20in%20touch.">Chat with TMP on WhatsApp</a>
    </div>
    <form method="post" class="contact-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="name" placeholder="Your name" required>
      <input name="email" type="email" placeholder="Email" required>
      <input name="subject" placeholder="Subject">
      <textarea name="message" placeholder="Message" required></textarea>
      <button class="btn" type="submit" title="Send your message to our team">Send Message</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
