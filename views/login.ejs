<%- include('partials/header') %>

<section class="page glass">
  <h1>Login</h1>
  <% if (typeof error !== 'undefined') { %><div class="notice error"><%= error %></div><% } %>
  <% if (typeof success !== 'undefined') { %><div class="notice success"><%= success %></div><% } %>
  
  <form method="post" class="auth-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    
    <div>
      <label for="email">Email or Username</label>
      <input id="email" name="email" type="text" placeholder="your@email.com or username" required>
    </div>
    
    <div>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" placeholder="Enter your password" required>
    </div>
    
    <button type="submit">Login</button>
  </form>
  
  <p style="text-align: center; margin-top: 20px;">
    <a href="/forgot-password" style="color: #3b82f6; text-decoration: none; font-weight: 500;">Forgot your password?</a>
  </p>
  <p style="text-align: center; color: #6b7280;">
    Don't have an account? <a href="/signup" style="color: #3b82f6; font-weight: 500;">Sign up here</a>
  </p>
</section>

<%- include('partials/footer') %>
