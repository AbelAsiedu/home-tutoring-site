<%- include('partials/header') %>

<section class="page glass">
  <h1>Login</h1>
  <% if (typeof error !== 'undefined') { %><div class="notice error"><%= error %></div><% } %>
  <% if (typeof success !== 'undefined') { %><div class="notice success"><%= success %></div><% } %>
  <form method="post" class="auth-form curved">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input name="email" placeholder="Email or username" required>
    <input name="password" type="password" placeholder="Password" required>
    <button type="submit">Login</button>
  </form>
  <p style="text-align: center; margin-top: 15px;">
    <a href="/forgot-password" style="color: #007bff; text-decoration: none;">Forgot your password?</a>
  </p>
</section>

<%- include('partials/footer') %>
