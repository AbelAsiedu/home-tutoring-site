<%- include('partials/header') %>

<section class="page glass">
  <h1>Reset Your Password</h1>
  
  <% if (typeof error !== 'undefined') { %>
    <div class="notice error"><%= error %></div>
  <% } %>
  
  <p style="text-align: center; margin-bottom: 20px;">
    Enter your new password below.
  </p>
  
  <form method="post" class="auth-form curved">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input name="password" type="password" placeholder="New password (min 8 characters)" required autofocus>
    <input name="confirmPassword" type="password" placeholder="Confirm new password" required>
    <button type="submit">Reset Password</button>
  </form>
  
  <p style="text-align: center; margin-top: 20px;">
    <a href="/login" style="color: #007bff;">Back to Login</a>
  </p>
</section>

<%- include('partials/footer') %>
