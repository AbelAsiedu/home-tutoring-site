<%- include('partials/header') %>

<section class="page glass auth-page">
  <h1>Reset Password</h1>
  
  <% if (typeof error !== 'undefined') { %>
    <div class="notice error"><%= error %></div>
  <% } %>
  
  <% if (typeof success !== 'undefined') { %>
    <div class="notice success"><%= success %></div>
    <p style="text-align: center; margin-top: 20px;">
      <a href="/login" style="color: #3b82f6; font-weight: 500;">Return to Login</a>
    </p>
  <% } else { %>
    <p style="text-align: center; margin-bottom: 20px; color: #6b7280;">
      Enter your email address and we'll send you a link to reset your password.
    </p>
    
    <form method="post" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label for="email">Email Address</label>
        <input id="email" name="email" type="email" placeholder="your@email.com" required autofocus>
      </div>
      <button type="submit" title="Send password reset link to your email">Send Reset Link</button>
    </form>
    
    <p style="text-align: center; margin-top: 20px;">
      <a href="/login" style="color: #3b82f6; text-decoration: none; font-weight: 500;">Back to Login</a>
    </p>
  <% } %>
</section>

<%- include('partials/footer') %>


<%- include('partials/footer') %>
