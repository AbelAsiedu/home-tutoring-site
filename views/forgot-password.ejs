<%- include('partials/header') %>

<section class="page glass">
  <h1>Reset Password</h1>
  
  <% if (typeof error !== 'undefined') { %>
    <div class="notice error"><%= error %></div>
  <% } %>
  
  <% if (typeof success !== 'undefined') { %>
    <div class="notice success"><%= success %></div>
    <p style="text-align: center; margin-top: 20px;">
      <a href="/login" style="color: #007bff;">Return to Login</a>
    </p>
  <% } else { %>
    <p style="text-align: center; margin-bottom: 20px;">
      Enter your email address and we'll send you a link to reset your password.
    </p>
    
    <form method="post" class="auth-form curved">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="email" type="email" placeholder="Email address" required autofocus>
      <button type="submit">Send Reset Link</button>
    </form>
    
    <p style="text-align: center; margin-top: 20px;">
      <a href="/login" style="color: #007bff;">Back to Login</a>
    </p>
  <% } %>
</section>

<%- include('partials/footer') %>
