<%- include('partials/header') %>
<main class="container">
  <section class="glass" style="padding:18px;">
    <h1><%= content('faq_title', 'Frequently Asked Questions') %></h1>
    <div style="margin-top:8px">
      <h4><%= content('faq_q1', 'What ages do you teach?') %></h4>
      <p class="muted"><%= content('faq_a1', 'We teach learners from primary school through secondary and offer adult learning support.') %></p>
      <h4><%= content('faq_q2', 'Do you offer online lessons?') %></h4>
      <p class="muted"><%= content('faq_a2', 'Yes — we offer both in-home and online lessons via video call.') %></p>
      <h4><%= content('faq_q3', 'How are tutors vetted?') %></h4>
      <p class="muted"><%= content('faq_a3', 'All tutors supply references, undergo an interview, and are observed before joining our network.') %></p>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
