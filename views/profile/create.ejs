<%- include('../partials/header') %>

<section class="page glass">
  <div style="max-width: 600px; margin: 0 auto;">
    <h1>Complete Your Profile</h1>
    <p style="color: #6b7280; margin-bottom: 24px;">Tell us about yourself so others can know you better. You can update this anytime.</p>
    
    <% if (typeof error !== 'undefined' && error) { %><div class="notice error"><%= error %></div><% } %>
    <% if (typeof message !== 'undefined' && message) { %><div class="notice success"><%= message %></div><% } %>

    <form method="post" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 16px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Avatar -->
      <div>
        <label for="avatar" style="display: block; font-weight: 600; margin-bottom: 8px;">Profile Picture</label>
        <input type="file" id="avatar" name="avatar" accept="image/*" style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
        <p style="font-size: 0.85rem; color: #6b7280; margin-top: 4px;">JPG, PNG or GIF (Max 5MB)</p>
      </div>

      <!-- Bio -->
      <div>
        <label for="bio" style="display: block; font-weight: 600; margin-bottom: 8px;">About You</label>
        <textarea id="bio" name="bio" placeholder="Tell us about yourself, your interests, and what you're looking for..." style="padding: 10px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%; min-height: 100px; font-family: inherit;" required></textarea>
      </div>

      <!-- Phone -->
      <div>
        <label for="phone" style="display: block; font-weight: 600; margin-bottom: 8px;">Phone Number (Optional)</label>
        <input type="tel" id="phone" name="phone" placeholder="+233 123 456 789" style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
      </div>

      <!-- Location -->
      <div>
        <label for="location" style="display: block; font-weight: 600; margin-bottom: 8px;">Location (Optional)</label>
        <input type="text" id="location" name="location" placeholder="City, Country" style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
      </div>

      <!-- Date of Birth -->
      <div>
        <label for="date_of_birth" style="display: block; font-weight: 600; margin-bottom: 8px;">Date of Birth (Optional)</label>
        <input type="date" id="date_of_birth" name="date_of_birth" style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
      </div>

      <!-- Occupation -->
      <div>
        <label for="occupation" style="display: block; font-weight: 600; margin-bottom: 8px;">Occupation (Optional)</label>
        <input type="text" id="occupation" name="occupation" placeholder="e.g. Teacher, Student, Developer" style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
      </div>

      <!-- Interests -->
      <div>
        <label for="interests" style="display: block; font-weight: 600; margin-bottom: 8px;">Interests (Optional)</label>
        <input type="text" id="interests" name="interests" placeholder="Comma-separated: reading, coding, music..." style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px;">
        <a href="/dashboard" class="btn ghost" style="text-align: center; text-decoration: none;">Skip for Now</a>
        <button type="submit" class="btn" style="background: #3b82f6; color: white;">Complete Profile</button>
      </div>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
