<%- include('../partials/header') %>

<section class="page glass">
  <div style="max-width: 600px; margin: 0 auto;">
    <h1>Edit Your Profile</h1>
    
    <% if (typeof error !== 'undefined' && error) { %><div class="notice error"><%= error %></div><% } %>
    <% if (typeof message !== 'undefined' && message) { %><div class="notice success"><%= message %></div><% } %>

    <form method="post" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 16px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Avatar -->
      <div>
        <label for="avatar" style="display: block; font-weight: 600; margin-bottom: 8px;">Profile Picture</label>
        <% if (profile.avatar_path) { %>
          <div style="margin-bottom: 12px;">
            <img src="<%= profile.avatar_path %>" alt="Profile" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 2px solid #3b82f6;">
          </div>
        <% } %>
        <input type="file" id="avatar" name="avatar" accept="image/*" style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
        <input type="hidden" name="current_avatar" value="<%= profile.avatar_path || '' %>">
        <p style="font-size: 0.85rem; color: #6b7280; margin-top: 4px;">Upload a new image to replace (optional)</p>
      </div>

      <!-- Bio -->
      <div>
        <label for="bio" style="display: block; font-weight: 600; margin-bottom: 8px;">About You</label>
        <textarea id="bio" name="bio" placeholder="Tell us about yourself..." style="padding: 10px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%; min-height: 100px; font-family: inherit;"><%- profile.bio || '' %></textarea>
      </div>

      <!-- Phone -->
      <div>
        <label for="phone" style="display: block; font-weight: 600; margin-bottom: 8px;">Phone Number</label>
        <input type="tel" id="phone" name="phone" placeholder="+233 123 456 789" value="<%- profile.phone || '' %>" style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
      </div>

      <!-- Location -->
      <div>
        <label for="location" style="display: block; font-weight: 600; margin-bottom: 8px;">Location</label>
        <input type="text" id="location" name="location" placeholder="City, Country" value="<%- profile.location || '' %>" style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
      </div>

      <!-- Date of Birth -->
      <div>
        <label for="date_of_birth" style="display: block; font-weight: 600; margin-bottom: 8px;">Date of Birth</label>
        <input type="date" id="date_of_birth" name="date_of_birth" value="<%- profile.date_of_birth || '' %>" style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
      </div>

      <!-- Occupation -->
      <div>
        <label for="occupation" style="display: block; font-weight: 600; margin-bottom: 8px;">Occupation</label>
        <input type="text" id="occupation" name="occupation" placeholder="e.g. Teacher, Student, Developer" value="<%- profile.occupation || '' %>" style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
      </div>

      <!-- Interests -->
      <div>
        <label for="interests" style="display: block; font-weight: 600; margin-bottom: 8px;">Interests</label>
        <input type="text" id="interests" name="interests" placeholder="Comma-separated: reading, coding, music..." value="<%- profile.interests || '' %>" style="padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; width: 100%;">
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px;">
        <a href="/dashboard" class="btn ghost" style="text-align: center; text-decoration: none;">Cancel</a>
        <button type="submit" class="btn" style="background: #3b82f6; color: white;">Save Changes</button>
      </div>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
