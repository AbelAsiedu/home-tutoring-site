<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Modern Pedagogues</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>

  <header class="site-header">
    <div class="nav-inner container">
      <div style="display:flex;align-items:center;gap:12px">
        <div class="brand">
          <span class="logo"></span>
          <span class="brand-text">The Modern Pedagogues</span>
        </div>
        <div class="nav-history" style="display:inline-flex;gap:6px">
          <button type="button" aria-label="Go back" class="btn ghost" style="padding:6px 10px" onclick="history.back()">←</button>
          <button type="button" aria-label="Go forward" class="btn ghost" style="padding:6px 10px" onclick="history.forward()">→</button>
        </div>
      </div>

      <button class="nav-toggle" aria-label="Toggle menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 7h18M3 12h18M3 17h18" stroke="#083344" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round"/></svg>
      </button>

      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="/curriculum">Curriculum</a>
        <a href="/estore">E-Store</a>
        <a href="/tutors">Tutors</a>
        <a href="/faq">FAQ</a>
        <a href="/apply">Apply</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>

          <div style="display:inline-flex;align-items:center;gap:8px">
            <a href="/cart" style="display:inline-flex;align-items:center;gap:8px">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6h15l-1.5 9h-11L6 6z" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round" strokeLinejoin="round"/><circle cx="10" cy="20" r="1" fill="currentColor"/><circle cx="18" cy="20" r="1" fill="currentColor"/></svg>
              <span>Cart</span>
              <span class="cart-badge"><%= (typeof cartCount !== 'undefined' && cartCount > 0) ? cartCount : '' %></span>
            </a>
            <button aria-label="Open mini cart" data-mini-toggle style="background:transparent;border:0;cursor:pointer;padding:6px;font-size:14px">▾</button>
          </div>
      </nav>

      <div class="mini-cart">
        <% if (cartItems && cartItems.length) { %>
          <ul>
            <% (cartItems || []).forEach(function(item){ %>
              <li data-cart-id="<%= item.id %>"><%= item.title %> x <%= item.qty %>
                <form method="post" action="/cart/remove" style="display:inline">
                  <input type="hidden" name="id" value="<%= item.id %>">
                  <button class="btn-link small" type="submit">Deselect</button>
                </form>
              </li>
            <% }) %>
          </ul>
          <button class="close-btn" id="cart-close-server" aria-label="Close">×</button>
          <a href="/cart" class="button">View cart</a>
          <form method="post" action="/cart/clear" style="display:inline">
            <button class="button alt" type="submit">Clear cart</button>
          </form>
          <button id="cart-cancel-server" class="button ghost">Cancel</button>
        <% } else { %>
          <div class="muted" style="padding:12px">Your cart is empty.</div>
        <% } %>
      </div>

      <div class="nav-actions">
        <% if (user) { %>
          <a href="/account" class="btn ghost">Hi <%= user.name %></a>
          <a href="/logout" class="btn">Logout</a>
        <% } else { %>
          <a href="/login" class="btn ghost">Login</a>
          <a href="/signup" class="btn">Sign up</a>
        <% } %>
      </div>
    </div>
  </header>

  <script>
    (function(){
      function updateBadge(){
        try{
          const el = document.querySelector('.cart-badge');
          if (!el) return;
          const local = JSON.parse(window.localStorage.getItem('mp_cart') || '{}');
          const count = Object.values(local || {}).reduce((s,n)=>s + (Number(n)||0), 0);
          el.textContent = count > 0 ? count : '';
        }catch(e){ /* ignore */ }
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', updateBadge); else updateBadge();
      window.addEventListener('cart:updated', updateBadge);
    })();
  </script>
