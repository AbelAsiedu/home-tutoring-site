<footer class="site-footer compact">
  <div class="footer-inner container">
    <div class="footer-left">
      <strong>The Modern Pedagogues</strong>
      <div class="muted">Home tutoring and education services — trusted &amp; professional</div>
    </div>
    <div class="footer-links">
      <div>Call: <a href="tel:+233000000000">+233 000 000 000</a></div>
      <div>WhatsApp: <a href="https://wa.me/233000000000">+233 000 000 000</a></div>
      <div>Email: <a href="mailto:info@modernpedagogues.example">info@modernpedagogues.example</a></div>
      <div><a href="/privacy">Privacy & Cookies</a></div>
    </div>
  </div>
  <div style="text-align:center;margin-top:16px;padding-top:12px;border-top:1px solid rgba(15,23,42,0.06)">
    <div style="display:inline-flex;gap:10px;margin-bottom:12px;flex-wrap:wrap;align-items:center;justify-content:center">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/account" class="btn ghost" title="View and edit your account settings">Hi <%= user.name %></a>
        <% if (user.role === 'creator' || user.role === 'admin') { %>
          <a href="/marketplace/creator/dashboard" class="btn ghost" title="Open your creator dashboard">Creator Dashboard</a>
        <% } else { %>
          <a href="/marketplace/seller/apply" class="btn ghost" title="Apply to become a verified marketplace seller">Become a Seller</a>
        <% } %>
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a href="/admin" class="btn ghost" title="Access admin control panel">Dashboard</a>
        <% } %>
        <a href="/logout" class="btn" title="Log out of your account">Logout</a>
      <% } else { %>
        <a href="/login" class="btn ghost" title="Sign in to your account">Login</a>
        <a href="/signup" class="btn" title="Create a new account">Sign up</a>
      <% } %>
    </div>
  </div>
  <div class="copyright">© <%= new Date().getFullYear() %> The Modern Pedagogues</div>
</footer>

<script src="/js/slideshow.js"></script>
<script src="/js/main.js"></script>
<script src="/js/admin-media-data.js"></script>
</body>
</html>
