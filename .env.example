# Admin credentials. REQUIRED in production: with NODE_ENV=production and no ADMIN_PASSWORD,
# no admin account is created and admin login is disabled. Use a long, unique password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_EMAIL=admin@your-domain.example

# Database
DATABASE_PATH=./data.db

# Session Secret (generate a random string for production)
SESSION_SECRET=change-this-to-a-random-string-in-production

# Email Service (configure for production)
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_FROM=noreply@modernpedagogues.com

# SMTP Email (alternative to SendGrid)
# EMAIL_SERVICE=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@modernpedagogues.com

# Application URL (for email links)
BASE_URL=http://localhost:3000

# Stripe (use test keys for development, live keys for production)
STRIPE_SECRET=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CURRENCY=usd

# Kaitlyn AI - keep secrets in the Codespace/server environment, never Git
GEMINI_API_KEY=your_gemini_api_key
GEMINI_INTERACTIONS_MODEL=gemini-3.6-flash
# GOOGLE_API_KEY=your_gemini_api_key
# OPENROUTER_API_KEY=your_openrouter_key
# OPENROUTER_MODEL=openrouter/free
# MISTRAL_API_KEY=your_mistral_key
# MISTRAL_MODEL=mistral-small-latest
# HUGGINGFACE_API_KEY=your_huggingface_key
# HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Environment
NODE_ENV=development
PORT=3000

# Security
# Cookies default to SameSite=Lax (recommended). Only set 'none' for a cross-origin frontend.
# COOKIE_SAMESITE=lax
# Comma-separated list of other origins allowed to call the API with cookies (usually empty).
# CORS_ORIGINS=
USE_HTTPS=false
SSL_KEY=
SSL_CERT=
TRUST_PROXY=false
